app:
  mode: LIVE
  timezone: Asia/Kolkata
venue:
  name: NSE
  api_key_env: KITE_API_KEY
  api_secret_env: KITE_API_SECRET
  access_token_env: KITE_ACCESS_TOKEN
risk:
  per_trade_risk_pct: 0.3
  max_portfolio_heat_pct: 1.0
  daily_loss_stop_pct: -2.5
  max_positions: 2
  max_position_size_multiplier: 1
  slippage_bps: 5
  fees_per_order: 20
  fees_per_option_leg: 20
market:
  open_time: 09:15
  close_time: '15:20'
  eod_squareoff_time: '15:25'
  eod_squareoff_enabled: true
  premarket_sync_time: 08:55
  event_aware: true
  event_stop_mult: 1.5
entry:
  window_start: 09:15
  window_end: '15:00'
  max_entries_per_day: 3
  cooldown_minutes: 30
execution:
  engine_gap_ms: 300
  instrument_gap_ms: 300
  price_band_bps: 40
  burst: 2
  fanout_per_sec: 4
  use_native_oco: false
  default_order_type: LIMIT
  limit_chase_ticks: 2
  limit_timeout_sec: 5
  ioc_for_exits: true
  max_order_retries: 3
  retry_backoff_ms: 500
  tops_cap_per_sec: 10
  use_limit_chase: true
  limit_chase_max_slippage_bps: 5.0
  limit_chase_timeout_ms: 500
  limit_chase_max_chases: 10
  tick_size: 0.05
delta_neutralizer:
  enabled: true
  underlying: NIFTY
  fut_symbol: NFO:NIFTY24NOVFUT
  rebalance_threshold: 50.0
  max_hedge_lots: 2
  lot_size: 25
universe:
  indices:
  - NIFTY
  fo_stocks_liquidity_rank_top_n: 0
  exclude_fo_ban: true
  exclude_illiquid_threshold_turnover: 10000000
  sync_time: 08:55
options:
  max_spread_mid_pct: 0.5
  min_oi: 50000
  min_last_traded_volume: 100
  strikes_from_atm: 5
  prefer_weekly: true
  max_dte: 7
  iv_percentile_min: 20
  iv_percentile_max: 80
strategies:
- name: OptionsRanker
  enabled: true
  priority: 1
  params:
    strategy_type: DEBIT_SPREAD
    max_positions: 1
    max_lot_size: 1
    instruments:
    - NIFTY
    ivp_min: 20
    ivp_max: 80
    liquidity_score_min: 0.7
    max_spread_legs: 2
    rr_min: 1.5
    max_cost_pct: 30
    min_pop: 40
    stop_loss_pct: 50
    take_profit_pct: 70
    require_trend_confirmation: true
    orb_window_min: 15
    require_breakout_confirmation: true
- name: expiry_short_strangle
  enabled: true
  priority: 2
  params:
    max_positions: 1
    max_lot_size: 1
    instruments:
    - NIFTY
    min_dte: 2
    max_dte: 7
    target_delta: 0.2
    min_ivp: 40
    max_ivp: 85
    min_premium_per_lot: 3000
    max_premium_per_lot: 8000
    stop_loss_mult: 2.0
    take_profit_pct: 50
    allowed_regimes:
    - LOW_MEAN_REVERT
    - MEDIUM_TREND
    exit_dte: 1
    exit_time: '15:00'
    entry_after_time: 09:30
    block_if_positions_exist: true
- name: expiry_short_strangle_v2
  enabled: true
  priority: 2
  params:
    pass_through: true
- name: intraday_short_strangle_v1
  enabled: true
  priority: 3
  params:
    pass_through: true
- name: trend_credit_spread_v1
  enabled: true
  priority: 4
  params:
    pass_through: true
- name: RegimeVolEngine
  enabled: true
  priority: 0
  params:
    pass_through: true
- name: GammaScalper
  enabled: true
  priority: 4
  params:
    pass_through: true
- name: CalendarArb
  enabled: true
  priority: 5
  params:
    pass_through: true
- name: DispersionArb
  enabled: true
  priority: 6
  params:
    pass_through: true
- name: TailShortVolOverlay
  enabled: true
  priority: 3
  params:
    short_vol_strategies:
    - expiry_short_strangle
    tail_underlyings:
    - NIFTY
    tail_type: DEEP_OTM_PUT
    strike_offset_pct: 5.0
    expiry_selector: next_month
    target_tail_coverage_pct: 15
    min_tail_coverage_pct: 10
    max_tail_coverage_pct: 25
    rebalance_interval_minutes: 30
    min_notional_change_pct: 10
    min_tail_gap_pct: 3
    max_days_to_expiry: 20
    pnl_take_profit_pct: 100
    pnl_stop_loss_pct: -70
    regime_coverage_multipliers:
      LOW_MEAN_REVERT: 1.0
      MEDIUM_TREND: 1.1
      HIGH_EVENT: 1.5
      CHAOTIC: 2.0
exits:
  debit_spread_stop_pct: 50
  debit_spread_tp_pct: 70
  debit_spread_timeout_min: 20
  credit_stop_mult: 2.0
  credit_tp_pct: 50
  time_stop_enabled: true
  time_stop_min: 20
  eod_flatten_enabled: true
  eod_flatten_time: '15:20'
guards:
  block_around_events_min: 10
  max_spread_mid_pct: 0.5
  min_liquidity_score: 0.7
  require_unique_order_ids: true
  audit_all_decisions: true
  max_total_positions: 4
  max_capital_deployed_pct: 15.0
  max_margin_used_pct: 30.0
ranking:
  weights:
    momentum: 0.2
    trend: 0.3
    liquidity: 0.25
    regime: 0.15
    rr: 0.1
  penalties:
    illiquid_mult: 0.5
    news_event_mult: 0.7
    far_from_vwap_mult: 0.8
  top_n: 3
shadow_strategies:
- intraday_short_strangle
- index_sniper
- drifting_credit_spread
- vscore_credit_spread
- kurtosis_straddle
