[Unit]
Description=AITRAPP Kite Trading Bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=trader
WorkingDirectory=/opt/aitrapp
EnvironmentFile=/opt/aitrapp/.env
ExecStart=/opt/aitrapp/.venv/bin/python3 -m uvicorn apps.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
# Hardening (adjust as needed)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
